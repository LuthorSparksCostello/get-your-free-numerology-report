# Auth0 Configuration
# Create a free Auth0 account at https://auth0.com
# 1. Create a new "Single Page Application" in the Auth0 dashboard
# 2. Copy your Domain and Client ID below
# 3. Enable Google, Apple, and Microsoft social connections
# 4. Add your app URLs to Allowed Callback URLs, Logout URLs, and Web Origins

VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id
VITE_AUTH0_CALLBACK_URL=http://localhost:8080
